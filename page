<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>NIWC Pacific | Operation Meridian Extreme</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Audiowide&family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@400;500;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#020714;--bg2:#06162e;--panel:rgba(8,25,50,.85);--panel2:rgba(0,255,224,.055);
  --cyan:#00ffe0;--cyan2:#00a9ff;--blue:#276dff;--amber:#ffc247;--red:#ff416d;--green:#6dff9e;
  --white:#eaf7ff;--muted:#7595c9;--line:rgba(0,255,224,.22);
  --title:'Orbitron',sans-serif;--display:'Audiowide',sans-serif;--mono:'Share Tech Mono',monospace;--body:'Rajdhani',sans-serif;
  --glitch-speed: 2s;
}
body.red-alert {
  --cyan: #ff416d;--cyan2: #ff003c;--blue: #ff2752;--line: rgba(255, 65, 109, 0.3);
  animation: screenShake 0.15s infinite alternate;
}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}
body{min-height:100vh;background:radial-gradient(circle at 20% 10%,rgba(0,169,255,.18),transparent 28%),radial-gradient(circle at 80% 20%,rgba(0,255,224,.12),transparent 25%),linear-gradient(135deg,#020714,#061225 52%,#01040c);color:var(--white);font-family:var(--body);overflow-x:hidden;cursor:none}
button{font:inherit;color:inherit}a{color:inherit}.hide{display:none!important}

#cursor,#cursor-dot{position:fixed;z-index:9999;pointer-events:none;transform:translate(-50%,-50%)}
#cursor{width:24px;height:24px;border:1px solid var(--cyan);border-radius:50%;box-shadow:0 0 20px rgba(0,255,224,.35);transition:.08s ease-out}
#cursor-dot{width:5px;height:5px;background:var(--cyan);border-radius:50%}

#starfield,#matrix{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
#matrix{opacity:.22;mix-blend-mode:screen}
.scanlines:after{content:"";position:fixed;inset:0;z-index:3;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(255,255,255,.03) 0,rgba(255,255,255,.03) 1px,transparent 1px,transparent 4px);animation:scan 4s linear infinite}
@keyframes scan{to{background-position:0 240px}}

.ocean{position:fixed;left:0;right:0;bottom:-8px;height:140px;z-index:1;opacity:.55;pointer-events:none;background:radial-gradient(ellipse at bottom,rgba(0,255,224,.28),transparent 60%)}
.wave{position:absolute;left:-10%;width:120%;height:100px;border-top:2px solid rgba(0,255,224,.4);border-radius:45%;animation:wave 7s ease-in-out infinite}
.wave:nth-child(1){bottom:0;animation-duration:6s}
.wave:nth-child(2){bottom:20px;animation-duration:9s;opacity:.65;border-top-color:var(--cyan2)}
.wave:nth-child(3){bottom:40px;animation-duration:13s;opacity:.4;border-top-color:var(--blue)}
@keyframes wave{50%{transform:translateX(5%) scaleY(.75) rotate(1deg)}}

#boot{position:fixed;inset:0;z-index:1000;background:#01050d;display:grid;place-items:center;overflow:hidden}
#boot:before{content:"";position:absolute;inset:-25%;background:conic-gradient(from 0deg,transparent,rgba(0,255,224,.15),transparent 30%,rgba(39,109,255,.15),transparent 70%);animation:spin 6s linear infinite}
.boot-card{position:relative;width:min(760px,92vw);border:1px solid var(--line);background:linear-gradient(180deg,rgba(6,22,46,.95),rgba(2,7,20,.98));box-shadow:0 0 70px rgba(0,255,224,.18),inset 0 0 40px rgba(0,255,224,.05);padding:40px;text-align:center;clip-path:polygon(0 24px,24px 0,100% 0,100% calc(100% - 24px),calc(100% - 24px) 100%,0 100%)}
.boot-logo{font-family:var(--display);font-size:clamp(28px,7vw,62px);letter-spacing:.1em;color:var(--cyan);text-shadow:0 0 30px rgba(0,255,224,.6);animation:glitchText 2s infinite}
.boot-sub{font-family:var(--mono);font-size:13px;color:var(--muted);letter-spacing:.25em;margin-top:10px}
.boot-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;text-align:left;margin:30px 0}@media(max-width:720px){.boot-grid{grid-template-columns:1fr}}
.boot-log{height:170px;overflow:hidden;border:1px solid rgba(0,255,224,.2);background:rgba(0,0,0,.5);padding:16px;font-family:var(--mono);font-size:12px;color:var(--muted);line-height:1.8;box-shadow:inset 0 0 15px rgba(0,0,0,0.8)}
.boot-radar{height:170px;border:1px solid rgba(0,255,224,.2);position:relative;overflow:hidden;background:radial-gradient(circle,rgba(0,255,224,.15),transparent 65%)}
.boot-radar:before{content:"";position:absolute;inset:20px;border:1px solid var(--line);border-radius:50%;box-shadow:0 0 0 30px rgba(0,255,224,.03),0 0 0 60px rgba(0,255,224,.02)}
.boot-radar:after{content:"";position:absolute;inset:0;background:conic-gradient(from 0deg,rgba(0,255,224,.4),transparent 30%);animation:spin 2s linear infinite}
.blip{position:absolute;width:8px;height:8px;background:var(--amber);border-radius:50%;box-shadow:0 0 20px var(--amber);z-index:2}
.b1{top:30%;left:70%;animation:pulse 1.5s infinite}
.b2{top:60%;left:25%;animation:pulse 2s infinite 0.5s}
.b3{top:15%;left:40%;animation:pulse 1.8s infinite 0.2s}
.boot-bar{height:6px;background:rgba(0,255,224,.1);border-radius:20px;overflow:hidden}
.boot-fill{height:100%;width:0;background:linear-gradient(90deg,var(--cyan),var(--cyan2));box-shadow:0 0 25px var(--cyan);transition:width .15s}
#enter{display:none;margin-top:24px;border:0;background:linear-gradient(90deg,var(--cyan),var(--cyan2));color:#00131c;font-family:var(--title);font-weight:900;letter-spacing:.2em;padding:16px 40px;cursor:pointer;box-shadow:0 0 35px rgba(0,255,224,.4);animation:buttonPulse 1.2s infinite}

@keyframes spin{to{transform:rotate(360deg)}}
@keyframes pulse{0%{opacity:1;transform:scale(1)}50%{opacity:0.2;transform:scale(2.2)}100%{opacity:1;transform:scale(1)}}
@keyframes buttonPulse{50%{transform:translateY(-3px);box-shadow:0 0 50px rgba(0,255,224,.8)}}

#app{position:relative;z-index:2;opacity:0;transition:1.2s cubic-bezier(0.1, 1, 0.1, 1)}#app.visible{opacity:1}
.hud{position:fixed;top:14px;left:50%;transform:translateX(-50%);width:min(1240px,96vw);height:68px;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:0 20px;border:1px solid var(--line);background:rgba(3,10,24,.85);backdrop-filter:blur(16px);box-shadow:0 0 40px rgba(0,255,224,.12);clip-path:polygon(0 14px,14px 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%)}
.brand{display:flex;align-items:center;gap:14px;font-family:var(--title);font-size:13px;letter-spacing:.2em;color:var(--cyan)}
.brand-mark{width:40px;height:40px;border:1px solid var(--cyan);border-radius:50%;display:grid;place-items:center;box-shadow:0 0 20px rgba(0,255,224,.3);animation:spin 20s linear infinite}
.brand span{display:block;color:var(--muted);font:10px var(--mono);letter-spacing:.12em;margin-top:3px}
.nav{display:flex;gap:10px}
.nav button{background:transparent;border:1px solid transparent;color:var(--muted);padding:10px 18px;font-family:var(--title);font-size:11px;letter-spacing:.15em;cursor:pointer;transition:0.2s}
.nav button:hover,.nav button.active{border-color:var(--cyan);color:var(--cyan);background:rgba(0,255,224,.08);box-shadow:0 0 15px rgba(0,255,224,0.15)}
.hud-metrics{display:flex;gap:16px;align-items:center}
.metric{text-align:right}
.metric strong{font-family:var(--title);font-size:19px;color:var(--cyan);text-shadow:0 0 10px rgba(0,255,224,0.4)}
.metric small{display:block;color:var(--muted);font:10px var(--mono);letter-spacing:.1em}
.status-dot{width:10px;height:10px;border-radius:50%;background:var(--green);box-shadow:0 0 20px var(--green);animation:pulse 1.5s infinite}
body.red-alert .status-dot {background:var(--red);box-shadow:0 0 20px var(--red)}

.page{display:none;min-height:100vh;padding:120px 0 80px;animation:pageIn 0.5s ease-out forwards}
@keyframes pageIn{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:none}}
.page.active{display:block}.container{max-width:1240px;margin:0 auto;padding:0 24px}

.hero{display:grid;grid-template-columns:1.1fr 0.9fr;gap:34px;align-items:center;min-height:calc(100vh - 150px)}
@media(max-width:980px){.hero{grid-template-columns:1fr;min-height:auto}}
.eyebrow{font-family:var(--mono);font-size:13px;letter-spacing:.35em;color:var(--cyan);text-transform:uppercase;margin-bottom:20px;display:flex;align-items:center;gap:8px}
.eyebrow:before{content:"";width:6px;height:6px;background:var(--cyan);border-radius:50%;animation:pulse 1s infinite}
.title{font-family:var(--title);font-weight:900;font-size:clamp(44px,7.5vw,90px);line-height:.95;letter-spacing:.02em;text-transform:uppercase}
.title .cyan{color:var(--cyan);text-shadow:0 0 40px rgba(0,255,224,.4)}
.title .outline{-webkit-text-stroke:1px rgba(234,247,255,.9);color:transparent}
.subtitle{margin:30px 0 38px;max-width:640px;color:#aac0e2;font-size:20px;line-height:1.6}
.subtitle em{font-style:normal;color:var(--white);font-weight:700;box-shadow:inset 0 -4px 0 var(--cyan)}
.cta-row{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:24px}

.btn{position:relative;border:1px solid var(--line);background:rgba(0,255,224,.06);color:var(--cyan);font-family:var(--title);font-weight:800;font-size:12px;letter-spacing:.2em;padding:16px 26px;cursor:pointer;transition:.25s;clip-path:polygon(0 10px,10px 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%);overflow:hidden}
.btn:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.15),transparent);transform:translateX(-100%);transition:0.5s}
.btn:hover:before{transform:translateX(100%)}
.btn.primary{background:linear-gradient(90deg,var(--cyan),var(--cyan2));color:#00121b;border:0}
.btn.danger{background:linear-gradient(90deg,var(--red),#b3002d);color:#fff;border:0;box-shadow:0 0 15px rgba(255,65,109,0.4)}
.btn:hover{transform:translateY(-4px);box-shadow:0 15px 35px rgba(0,255,224,.25)}

.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:30px}@media(max-width:760px){.stats{grid-template-columns:repeat(2,1fr)}}
.stat{border:1px solid rgba(0,255,224,.2);background:var(--panel);padding:20px;position:relative;overflow:hidden;backdrop-filter:blur(10px)}
.stat:before{content:"";position:absolute;left:-100%;top:0;width:100%;height:2px;background:linear-gradient(90deg,transparent,var(--cyan),transparent);animation:laser 2.5s infinite}
.stat:nth-child(2):before{animation-delay:.5s}
.stat:nth-child(3):before{animation-delay:1s}
.stat:nth-child(4):before{animation-delay:1.5s}
@keyframes laser{to{left:100%}}
.stat strong{font-family:var(--title);font-size:32px;color:var(--cyan);text-shadow:0 0 10px rgba(0,255,224,0.2)}
.stat span{display:block;color:var(--muted);font:12px var(--mono);letter-spacing:.15em;text-transform:uppercase;margin-top:4px}

/* Cyber Image Component overlays */
.cyber-image-frame {
  position: relative; width: 100%; height: 220px; overflow: hidden;
  border: 1px solid var(--line); margin-bottom: 16px;
}
.cyber-image-frame img {
  width: 100%; height: 100%; object-fit: cover; filter: saturate(1.4) hue-rotate(-15deg);
  transition: transform 0.5s ease; mix-blend-mode: luminosity;
}
.cyber-image-frame:hover img { transform: scale(1.08); mix-blend-mode: normal; }
.cyber-image-frame:after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(to bottom, transparent 70%, rgba(2,7,20,0.85)), radial-gradient(circle, transparent 30%, rgba(0,255,224,0.15));
  pointer-events: none;
}
.cyber-image-frame .hud-overlay {
  position: absolute; inset: 10px; border: 1px solid rgba(0,255,224,0.2);
  pointer-events: none; display: flex; justify-content: space-between; align-items: flex-end;
  font: 11px var(--mono); color: var(--cyan); padding: 6px; text-shadow: 0 0 5px #000;
}

.ship-display{position:relative;min-height:540px;border:1px solid var(--line);background:linear-gradient(180deg,rgba(8,25,50,.65),rgba(1,7,18,.85));overflow:hidden;clip-path:polygon(0 30px,30px 0,100% 0,100% calc(100% - 30px),calc(100% - 30px) 100%,0 100%);box-shadow:inset 0 0 60px rgba(0,255,224,.06);display:flex;flex-direction:column;justify-content:space-between}
/* Real background photo inside ship display */
.ship-bg-photo {
  position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  opacity: 0.18; mix-blend-mode: overlay; pointer-events: none; animation: subtlePan 30s linear infinite alternate;
}
@keyframes subtlePan { from {transform: scale(1) translate(0, 0)} to {transform: scale(1.15) translate(-2%, -2%)} }

.holo-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(0,255,224,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(0,255,224,.05) 1px,transparent 1px);background-size:40px 40px;transform:perspective(600px) rotateX(60deg) translateY(60px);transform-origin:bottom;animation:gridDrift 3s linear infinite}@keyframes gridDrift{to{background-position:40px 40px}}
.ship-svg{position:absolute;left:50%;top:42%;width:80%;transform:translate(-50%,-50%);filter:drop-shadow(0 0 35px rgba(0,255,224,.6));animation:float 4s ease-in-out infinite;z-index:2}
.ship-path{fill:rgba(0,255,224,.05);stroke:var(--cyan);stroke-width:1.5;stroke-dasharray: 800;stroke-dashoffset: 800;animation:drawOutline 4s ease-out forwards}
@keyframes drawOutline { to { stroke-dashoffset: 0 } }
.ship-deck{stroke:var(--cyan2);stroke-width:2;fill:none}
.thruster{fill:var(--amber);filter:drop-shadow(0 0 15px var(--amber));animation:thrust .3s infinite alternate}
@keyframes float{0%,100%{transform:translate(-50%,-42%) rotate(0deg)}50%{transform:translate(-50%,-46%) rotate(-1.5deg)}}
@keyframes thrust{to{opacity:.2;transform:scaleX(1.4)}}

.radar-ui{position:absolute;right:20px;top:20px;width:140px;height:140px;border:1px solid var(--line);border-radius:50%;background:radial-gradient(circle,rgba(0,255,224,.15),transparent 65%);z-index:2}
.radar-ui:before{content:"";position:absolute;inset:12px;border:1px dashed rgba(0,255,224,.35);border-radius:50%}
.radar-ui:after{content:"";position:absolute;inset:0;background:conic-gradient(from 0deg,rgba(0,255,224,.5),transparent 30%);border-radius:50%;animation:spin 2s linear infinite}

.commander{position:relative;margin:24px;border:1px solid rgba(255,194,71,.4);background:rgba(4,14,32,.85);backdrop-filter:blur(8px);padding:18px;display:grid;grid-template-columns:70px 1fr;gap:16px;z-index:5;box-shadow:0 10px 30px rgba(0,0,0,0.5)}
.avatar{width:70px;height:70px;border:1px solid var(--amber);background-image:url('https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80');background-size:cover;background-position:center;position:relative}
.avatar:after{content:"";position:absolute;inset:0;background:linear-gradient(45deg,rgba(255,194,71,0.3),transparent);mix-blend-mode:color}
.dialogue small{font-family:var(--mono);color:var(--amber);letter-spacing:.2em;font-weight:bold}
.dialogue p{font:15px/1.6 var(--mono);margin-top:6px;color:var(--white)}

.section-head{margin-bottom:34px;position:relative}.section-head h2{font-family:var(--title);font-size:clamp(28px,4.5vw,46px);letter-spacing:.08em;text-transform:uppercase}
.section-head p{font:14px var(--mono);color:var(--muted);letter-spacing:.15em;margin-top:8px}
.line{width:80px;height:3px;background:linear-gradient(90deg,var(--cyan),transparent);margin-top:16px}

.mission-map{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin:40px 0 20px}@media(max-width:1024px){the-mission-map,.mission-map{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.mission-map{grid-template-columns:1fr}}
.mission{position:relative;min-height:430px;border:1px solid rgba(0,255,224,.2);background:linear-gradient(180deg,rgba(8,25,50,.9),rgba(3,10,24,.85));padding:24px;overflow:hidden;cursor:pointer;transition:.3s cubic-bezier(0.2, 1, 0.2, 1);clip-path:polygon(0 20px,20px 0,100% 0,100% calc(100% - 20px),calc(100% - 20px) 100%,0 100%);display:flex;flex-direction:column;justify-content:space-between}
.mission:hover{transform:translateY(-10px) scale(1.02);border-color:var(--cyan);box-shadow:0 20px 50px rgba(0,255,224,.2),inset 0 0 20px rgba(0,255,224,0.05)}
.mission:before{content:"";position:absolute;inset:-1px;background:radial-gradient(circle at var(--mx,50%) var(--my,50%),rgba(0,255,224,.25),transparent 40%);opacity:0;transition:.25s;pointer-events:none}
.mission:hover:before{opacity:1}
.mission-num{font-family:var(--title);font-size:12px;color:var(--cyan);letter-spacing:.25em}
.icon-ring{margin:14px 0;width:64px;height:64px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;font-size:26px;box-shadow:inset 0 0 15px rgba(0,255,224,.1);transition:0.3s}
.mission:hover .icon-ring{transform:rotate(360deg);border-color:var(--cyan);box-shadow:0 0 20px rgba(0,255,224,0.3)}
.mission h3{font-family:var(--title);font-size:20px;line-height:1.2;margin-bottom:8px}
.mission p{color:#9db6d8;font-size:15px;line-height:1.55;flex-grow:1}
.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:16px}
.tag{font:11px var(--mono);color:var(--cyan);border:1px solid rgba(0,255,224,.3);padding:4px 10px;background:rgba(0,255,224,.06)}
.tag.red{color:var(--red);border-color:rgba(255,65,109,.45);background:rgba(255,65,109,.05)}
.tag.amber{color:var(--amber);border-color:rgba(255,194,71,.45);background:rgba(255,194,71,.05)}

.control-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:20px}@media(max-width:900px){.control-grid{grid-template-columns:1fr}}
.panel{border:1px solid rgba(0,255,224,.2);background:var(--panel);padding:26px;clip-path:polygon(0 16px,16px 0,100% 0,100% calc(100% - 16px),calc(100% - 16px) 100%,0 100%);backdrop-filter:blur(12px)}
.panel h3{font-family:var(--title);font-size:20px;color:var(--cyan);margin-bottom:16px;letter-spacing:0.05em}
.timeline{display:grid;gap:16px}
.step{display:grid;grid-template-columns:50px 1fr;gap:16px;align-items:start}
.step-num{height:50px;border:1px solid var(--cyan);display:grid;place-items:center;font-family:var(--title);color:var(--cyan);font-weight:900;box-shadow:0 0 10px rgba(0,255,224,0.15)}
.step h4{font-family:var(--title);font-size:15px;margin-bottom:4px}
.step p{font-size:15px;color:#a8bbda;line-height:1.5}
.step code{font-family:var(--mono);color:var(--cyan);background:rgba(0,255,224,.1);padding:2px 6px;border-radius:3px}

.score-rings{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.ring{aspect-ratio:1;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;position:relative;background:conic-gradient(var(--cyan) calc(var(--pct)*1%),rgba(0,255,224,.05) 0);transition: background 0.5s ease}
.ring:after{content:"";position:absolute;inset:12px;background:#06162e;border-radius:50%;border:1px solid rgba(0,255,224,.15)}
.ring span{position:relative;z-index:1;text-align:center;font-family:var(--title);font-size:22px;color:var(--cyan);font-weight:800}
.ring small{display:block;font:11px var(--mono);color:var(--muted);letter-spacing:.12em;font-weight:normal;margin-top:2px}

.terminal{margin-top:20px;border:1px solid rgba(0,255,224,.2);background:rgba(0,0,0,.6);font-family:var(--mono);font-size:14px;line-height:1.7;box-shadow:inset 0 0 20px #000}
.term-bar{padding:10px 16px;border-bottom:1px solid rgba(0,255,224,.15);color:var(--muted);display:flex;justify-content:space-between;background:rgba(5,15,35,0.6)}
.term-body{padding:16px;color:#b8d2f0;min-height:180px;max-height:300px;overflow-y:auto}
.cmd{color:var(--cyan)}.out{color:var(--amber)}.good{color:var(--green)}.bad{color:var(--red)}

#modalOverlay{position:fixed;inset:0;z-index:100;display:none;place-items:center;background:rgba(1,5,13,.9);backdrop-filter:blur(12px);padding:20px}#modalOverlay.open{display:grid}
.modal{width:min(860px,96vw);max-height:88vh;overflow:auto;border:1px solid var(--line);background:linear-gradient(180deg,#071b36,#030b19);clip-path:polygon(0 26px,26px 0,100% 0,100% calc(100% - 26px),calc(100% - 26px) 100%,0 100%);box-shadow:0 0 80px rgba(0,255,224,.25);animation:modalIn .3s cubic-bezier(0.1, 1, 0.1, 1)}
.modal-head{display:flex;justify-content:space-between;gap:18px;padding:26px;border-bottom:1px solid rgba(0,255,224,.2);background:rgba(0,0,0,0.2)}
.modal-head h3{font-family:var(--title);color:var(--cyan);font-size:26px;letter-spacing:0.05em}
.close{border:1px solid var(--line);background:transparent;color:var(--muted);padding:10px 16px;cursor:pointer;font-family:var(--title);font-size:11px;transition:0.2s}
.close:hover{border-color:var(--red);color:var(--red);background:rgba(255,65,109,0.1)}
.modal-body{padding:26px}.dossier{display:grid;gap:22px}
