<body class="scanlines">
<canvas id="starfield"></canvas><canvas id="matrix"></canvas><div class="ocean"><div class="wave"></div><div class="wave"></div><div class="wave"></div></div><div id="cursor"></div><div id="cursor-dot"></div>

<div id="boot"><div class="boot-card"><div class="boot-logo">OPERATION MERIDIAN</div><div class="boot-sub">NIWC PACIFIC // CYBER DEFENSE SYSTEMS CONTROL</div><div class="boot-grid"><div class="boot-log" id="bootLog"></div><div class="boot-radar"><div class="blip b1"></div><div class="blip b2"></div><div class="blip b3"></div></div></div><div class="boot-bar"><div class="boot-fill" id="bootFill"></div></div><button id="enter" onclick="enterApp()">ENTER MISSION CONTROL ›</button></div></div>

<div id="app">
<header class="hud"><div class="brand"><div class="brand-mark">⚓</div><div>NIWC PACIFIC<span>USS MERIDIAN C2 NODE</span></div></div><nav class="nav"><button class="active" onclick="showPage('home',this)">HOME</button><button onclick="showPage('missions',this)">MISSIONS</button><button onclick="showPage('score',this)">SCORE</button><button onclick="showPage('setup',this)">SETUP</button></nav><div class="hud-metrics"><div class="metric"><strong id="hudScore">000</strong><small>XP</small></div><div class="metric"><strong id="clock">60:00</strong><small>MISSION TIMER</small></div><div class="status-dot"></div></div></header>

<main>
<section id="page-home" class="page active"><div class="container hero"><div><p class="eyebrow">// COMMS ESTABLISHED WITH COMMANDER WELLS</p><h1 class="title"><span class="cyan glitch" data-text="NAVY CYBER">NAVY CYBER</span><br><span class="outline">ESCAPE ROOM</span></h1><p class="subtitle">A simulated shipboard Linux workstation is compromised. You have <em>60 minutes</em> to audit users, analyze packet captures, recover evidence, and lock down the network before the USS Meridian deploys.</p><div class="cta-row"><button class="btn primary" onclick="showPage('missions',document.querySelectorAll('.nav button')[1]);unlockAchievement('Boot Sequence Complete','Mission control is online.')">BEGIN OPERATION</button><button class="btn" onclick="showPage('setup',document.querySelectorAll('.nav button')[3])">VIEW VM SETUP</button><button class="btn danger" onclick="toggleRedAlert()">TOGGLE RED ALERT</button></div><div class="stats"><div class="stat"><strong>04</strong><span>Operations</span></div><div class="stat"><strong>60</strong><span>Minutes</span></div><div class="stat"><strong>400</strong><span>Max XP</span></div><div class="stat"><strong>LIVE</strong><span>Threat Sim</span></div></div></div><div class="ship-display"><img class="ship-bg-photo" src="https://images.unsplash.com/photo-1507682531662-421b17a471c1?auto=format&fit=crop&w=800&q=80" alt="Navy vessel"><div class="holo-grid"></div><div class="radar-ui"></div><svg class="ship-svg" viewBox="0 0 600 260" aria-label="holographic ship"><path class="ship-path" d="M44 147 C112 118 205 100 330 102 L420 72 L468 103 L556 112 C535 154 503 181 449 194 L147 194 C98 186 62 171 44 147Z"/><path class="ship-deck" d="M156 116 L236 80 L337 82 L396 111 M217 111 L217 70 M278 103 L278 52 M338 106 L338 72 M111 151 L505 151 M165 174 L457 174"/><circle class="thruster" cx="92" cy="151" r="9"/><circle class="thruster" cx="125" cy="175" r="7"/></svg><div class="commander"><div class="avatar"></div><div class="dialogue"><small>CMDR. WELLS // MISSION BRIEF</small><p id="typeText">Analyst, the ship network is sending signals it should not. Find the breach. Secure the system. Bring Meridian back online.</p></div></div></div></div></section>
<section id="page-missions" class="page"><div class="container"><div class="section-head"><h2>ACTIVE OPERATIONS</h2><p>// Choose a quest. Each one teaches a real cyber skill.</p><div class="line"></div></div><div class="mission-map" id="missionMap"></div></div></section>
<section id="page-score" class="page"><div class="container"><div class="section-head"><h2>MISSION SCOREBOARD</h2><p>// Demo score UI. Later you can connect this to score.sh output.</p><div class="line"></div></div><div class="control-grid"><div class="panel"><h3>Live Scoring Feed</h3><div class="terminal"><div class="term-bar"><span>score.sh</span><span>BASH</span></div><div class="term-body" id="term"><span class="cmd">$ sudo ./score.sh</span><br><span class="out">Waiting for scoring engine...</span><br><span class="out">Tip: use this page as the mission dashboard while students work inside the VM.</span></div></div><div class="cta-row" style="margin-top:16px"><button class="btn primary" onclick="simulateScore()">SIMULATE SCORE UPDATE</button><button class="btn" onclick="resetScore()">RESET DISPLAY</button></div></div><div class="panel"><h3>Operation Progress</h3><div class="score-rings"><div class="ring" id="r1" style="--pct:0"><span>0%<small>OP-01</small></span></div><div class="ring" id="r2" style="--pct:0"><span>0%<small>OP-02</small></span></div><div class="ring" id="r3" style="--pct:0"><span>0%<small>OP-03</small></span></div><div class="ring" id="r4" style="--pct:0"><span>0%<small>OP-04</small></span></div></div></div></div></div></section>
<section id="page-setup" class="page"><div class="container"><div class="section-head"><h2>VM DEPLOYMENT GUIDE</h2><p>// Simple steps for students before the mission begins.</p><div class="line"></div></div><div class="panel"><div class="timeline"><div class="step"><div class="step-num">01</div><div><h4>Open VMware Workstation Player</h4><p>Load the Ubuntu-based Navy Cyber VM. Keep networking on <code>NAT</code> or <code>Host-only</code>.</p></div></div><div class="step"><div class="step-num">02</div><div><h4>Log in as the student analyst</h4><p>Use the account you create for players, such as <code>analyst</code>. Do not log in as the builder/admin account.</p></div></div><div class="step"><div class="step-num">03</div><div><h4>Open mission control</h4><p>Keep this webpage open as the story dashboard while solving tasks inside Ubuntu.</p></div></div><div class="step"><div class="step-num">04</div><div><h4>Run scoring checks</h4><p>Inside the VM, run <code>sudo ./score.sh</code> when you want progress feedback.</p></div></div><div class="step"><div class="step-num">05</div><div><h4>Submit final answers</h4><p>Forensic answers can be saved to files like <code>~/forensics/dns_finding.txt</code>.</p></div></div></div></div></div></section>
</main></div>

<div id="modalOverlay" onclick="closeModal(event)"><div class="modal"><div class="modal-head"><h3 id="modalTitle">Mission</h3><button class="close" onclick="closeModalDirect()">CLOSE ✕</button></div><div class="modal-body" id="modalBody"></div></div></div><div id="toast"></div><div class="achievement" id="achievement"><div class="badge">XP</div><div><strong id="achTitle">Achievement</strong><p id="achText">Unlocked.</p></div></div>

<script>
// Web Audio SFX Engine (Generates synthesized real-time synth sounds on demand)
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playTone(freq, type, duration, vol) {
  try {
    const osc = audioCtx.createOscillator();
    const gainNode = audioCtx.createGain();
    osc.type = type; osc.frequency.value = freq;
    gainNode.gain.setValueAtTime(vol, audioCtx.currentTime);
    gainNode.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
    osc.connect(gainNode); gainNode.connect(audioCtx.destination);
    osc.start(); osc.stop(audioCtx.currentTime + duration);
  } catch(e){}
}
function sndClick() { playTone(600, 'sine', 0.08, 0.1); }
function sndBeep() { playTone(880, 'square', 0.15, 0.05); }
function sndAlert() { playTone(180, 'sawtooth', 0.4, 0.2); setTimeout(()=>playTone(150, 'sawtooth', 0.4, 0.2), 200); }
function sndAchieve() { 
  playTone(523.25, 'sine', 0.1, 0.15);
  setTimeout(()=>playTone(659.25, 'sine', 0.1, 0.15), 80);
  setTimeout(()=>playTone(783.99, 'sine', 0.15, 0.15), 160);
  setTimeout(()=>playTone(1046.50, 'sine', 0.3, 0.2), 240);
}

const $=s=>document.querySelector(s),$$=s=>document.querySelectorAll(s);
const cursor=$('#cursor'),dot=$('#cursor-dot');
document.addEventListener('mousemove',e=>{
  cursor.style.left=dot.style.left=e.clientX+'px';
  cursor.style.top=dot.style.top=e.clientY+'px'
});
document.addEventListener('mouseover',e=>{
  if(e.target.closest('button,.mission')){
    cursor.style.width='42px';cursor.style.height='42px';cursor.style.borderColor='var(--amber)';
  }
});
document.addEventListener('mouseout',e=>{
  if(e.target.closest('button,.mission')){
    cursor.style.width='24px';cursor.style.height='24px';cursor.style.borderColor='var(--cyan)';
  }
});
document.addEventListener('click', () => { sndClick(); });

function setupCanvas(id,draw){const c=$(id),ctx=c.getContext('2d');function resize(){c.width=innerWidth;c.height=innerHeight}resize();addEventListener('resize',resize);draw(c,ctx)}
setupCanvas('#starfield',(c,ctx)=>{let stars=Array.from({length:140},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,z:Math.random()*2+.2,s:Math.random()*1.8+.3}));function loop(){ctx.clearRect(0,0,c.width,c.height);for(const st of stars){st.y+=st.z*.35;if(st.y>c.height){st.y=0;st.x=Math.random()*c.width}ctx.fillStyle=`rgba(0,255,224,${.2+st.z*.2})`;ctx.fillRect(st.x,st.y,st.s,st.s)}requestAnimationFrame(loop)}loop()});
setupCanvas('#matrix',(c,ctx)=>{const chars='01 MERIDIAN SCAPY DNS UFW SSH LOGS NAVY NIWC';let drops=[];function init(){drops=Array(Math.floor(c.width/18)).fill(0)}init();addEventListener('resize',init);setInterval(()=>{ctx.fillStyle='rgba(2,7,20,.14)';ctx.fillRect(0,0,c.width,c.height);ctx.fillStyle='rgba(0,255,224,.4)';ctx.font='14px Share Tech Mono';drops.forEach((y,i)=>{ctx.fillText(chars[Math.floor(Math.random()*chars.length)],i*18,y);if(y>c.height&&Math.random()>.975)drops[i]=0;else drops[i]+=18})},45)});

const bootLines=['Powering NIWC mission console...','Linking to USS Meridian C2 node...','Loading Linux hardening module...','Scapy packet analyzer: ONLINE','Wireshark capture module: ONLINE','Forensic evidence vault: MOUNTED','WARNING: DNS exfiltration suspected','WARNING: Unauthorized sudo activity','Commander Wells requesting analyst login...','Mission control ready.'];
let bi=0;
function boot(){
  if(bi Rez>=bootLines.length){$('#enter').style.display='inline-block';sndAchieve();return}
  let p=document.createElement('p');p.textContent='> '+bootLines[bi];
  if(p.textContent.includes('WARNING')){p.style.color='var(--red)';sndBeep();}
  if(p.textContent.includes('ONLINE'))p.style.color='var(--green)';
  $('#bootLog').appendChild(p);$('#bootLog').scrollTop=$('#bootLog').scrollHeight;
  $('#bootFill').style.width=(bi+1)/bootLines.length*100+'%';bi++;
  setTimeout(boot,bi<4?120:200)
}
setTimeout(boot,500);

function enterApp(){
  audioCtx.resume();
  $('#boot').style.animation='fadeOut .6s forwards';
  setTimeout(()=>$('#boot').classList.add('hide'),600);
  $('#app').classList.add('visible');
  toast('ANALYST AUTHENTICATED — CYBER NODE LIVE');
  startTimer();
  renderMissions();
}
document.head.insertAdjacentHTML('beforeend','<style>@keyframes fadeOut{to{opacity:0;visibility:hidden;pointer-events:none}}</style>');

let time=3600,timer=null;
function startTimer(){
  if(timer)return;
  timer=setInterval(()=>{
    time=Math.max(0,time-1);
    let m=String(Math.floor(time/60)).padStart(2,'0'),s=String(time%60).padStart(2,'0');
    $('#clock').textContent=`${m}:${s}`;
    if(time<=300) { $('body').classList.add('red-alert'); }
  },1000)
}

function showPage(name,btn){
  $$('.page').forEach(p=>p.classList.remove('active'));
  $('#page-'+name).classList.add('active');
  $$('.nav button').forEach(b=>b.classList.remove('active'));
  if(btn)btn.classList.add('active');
  toast('DISPLAYING '+name.toUpperCase()+' COMPONENT');
}

function toggleRedAlert() {
  document.body.classList.toggle('red-alert');
  if(document.body.classList.contains('red-alert')) {
    sndAlert();
    toast('CRITICAL SYSTEM THREAT: RED ALERT ACTIVATED');
  } else {
    toast('SYSTEM THREAT LEVEL NORMALIZED');
  }
}

const missions=[
  {id:'q1',num:'OP-01',icon:'👤',title:'Ghost in the Roster',time:'10–15 min',desc:'Unknown accounts and sudo abuse on the ship workstation.',tags:['USERS','SUDO','PRIV ESC'],story:'An unknown contractor account appeared on the command server. One account may have root-level access. Audit the roster and remove unauthorized privileges.',objectives:['List Linux users and compare against the authorized roster.','Audit sudo membership and remove unauthorized admins.','Find any UID 0 backdoor accounts.','Fix world-writable home directory permissions.'],tools:['cat /etc/passwd','getent group sudo','sudo userdel -r','chmod','passwd -S'],hint:'UID 0 means root-level power. Any UID 0 account besides root is a serious red flag.',img:'https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=500&q=80'},
  {id:'q2',num:'OP-02',icon:'📡',title:'Dark Signal',time:'15–20 min',desc:'Analyze suspicious network traffic using Scapy and Wireshark.',tags:['SCAPY','PCAP','DNS'],story:'Sensors detected weird DNS traffic leaving the ship network. The attacker may be hiding data inside DNS queries.',objectives:['Open meridian_traffic.pcap.','Use Scapy rdpcap to filter DNS queries.','Identify suspicious base64-looking subdomains.','Decode the hidden exfiltration message.','Save the attacker destination IP.'],tools:['wireshark','scapy rdpcap','DNSQR','base64 -d','python3'],hint:'DNS tunneling often hides payloads inside subdomain labels, like encodedtext.attacker.net.',img:'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=500&q=80'},
  {id:'q3',num:'OP-03',icon:'🔍',title:'Buried Evidence',time:'10–15 min',desc:'Recover clues from logs, hidden files, and attacker leftovers.',tags:['LOGS','FORENSICS','EVIDENCE'],story:'The attacker tried to erase their traces, but logs and hidden files still contain evidence.',objectives:['Check /var/log/auth.log for suspicious login activity.','Find hidden files in user home folders.','Inspect crontab for persistence.','Search for suspicious SUID binaries.'],tools:['grep','ls -la','find / -perm -4000','cat /etc/crontab'],hint:'Always use ls -la. Hidden files start with a dot.',img:'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=500&q=80'},
  {id:'q4',num:'OP-04',icon:'🛡️',title:'Lock It Down',time:'10–15 min',desc:'Enable firewall rules, disable insecure services, and patch.',tags:['UFW','SERVICES','PATCH'],story:'Now that the intrusion is understood, harden the system before the ship deploys.',objectives:['Enable UFW and deny incoming traffic by default.','Allow only approved ports.','Disable Telnet/FTP if present.','Run package updates.','Confirm open ports with ss.'],tools:['sudo ufw enable','ss -tlnp','systemctl disable --now','apt update'],hint:'Telnet and FTP are plain-text protocols and should not remain active on a secure workstation.',img:'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=500&q=80'}
];

function renderMissions(){
  let map=$('#missionMap');
  map.innerHTML=missions.map(m=>`
    <article class="mission" onclick="openMission('${m.id}')" onmousemove="this.style.setProperty('--mx',event.offsetX+'px');this.style.setProperty('--my',event.offsetY+'px')">
      <div>
        <div class="mission-num">${m.num} // ${m.time}</div>
        <div class="icon-ring">${m.icon}</div>
        <h3>${m.title}</h3>
        <div class="cyber-image-frame">
          <img src="${m.img}" alt="${m.title}">
          <div class="hud-overlay"><span>NIWC_SEC_SYS</span><span>SYS_OK</span></div>
        </div>
        <p>${m.desc}</p>
      </div>
      <div class="tags">${m.tags.map((t,i)=>`<span class="tag ${i==2?'red':i==1?'amber':''}">${t}</span>`).join('')}</div>
    </article>
  `).join('');
}

function openMission(id){
  const m = missions.find(x=>x.id===id);
  if(!m) return;
  $('#modalTitle').textContent = `${m.num} // ${m.title}`;
  $('#modalBody').innerHTML = `
    <div class="dossier">
      <div><h4>Tactical Intelligence Briefing</h4><p style="margin-top:8px;">${m.story}</p></div>
      <div><h4>Primary Directives</h4><ul style="margin-top:8px;">${m.objectives.map(o=>`<li>${o}</li>`).join('')}</ul></div>
      <div><h4>Recommended Terminal Frameworks</h4><div class="toolchips" style="margin-top:8px;">${m.tools.map(t=>`<code>${t}</code>`).join('')}</div></div>
      <div class="hint"><strong>COMMS TRACE DATA HINT:</strong> ${m.hint}</div>
      <button class="btn primary" onclick="completeMissionSimulation('${m.id}')">MARK OBJECTIVE CLEARED</button>
    </div>
  `;
  $('#modalOverlay').classList.add('open');
}

function closeModal(e){ if(e.target===$('#modalOverlay')) closeModalDirect(); }
function closeModalDirect(){ $('#modalOverlay').classList.remove('open'); }

let currentXp = 0;
function completeMissionSimulation(id) {
  closeModalDirect();
  currentXp += 100;
  $('#hudScore').textContent = String(currentXp).padStart(3,'0');
  
  const mIndex = missions.findIndex(x=>x.id===id);
  if(mIndex !== -1) {
    const ringId = `#r${mIndex + 1}`;
    $(ringId).style.setProperty('--pct', '100');
    $(ringId).querySelector('span').innerHTML = `100%<small>${missions[mIndex].num}</small>`;
    $(ringId).style.background = 'rgba(109,255,158,0.1)';
  }
  
  sndAchieve();
  unlockAchievement('Operational Objective Cleared', `Earned 100 XP verifying system telemetry.`);
}

function simulateScore(){
  const logs = [
    '<span class="good">[SUCCESS]</span> Extraneous root UID 0 profiles flagged and deleted.',
    '<span class="good">[SUCCESS]</span> Discovered Base64 token leaking inside Scapy raw layer.',
    '<span class="good">[SUCCESS]</span> Backdoor crontab automation path identified and purged.',
    '<span class="good">[SUCCESS]</span> Port rules activated via UFW. Unauthorized vectors drop traffic.'
  ];
  const rLog = logs[Math.floor(Math.random()*logs.length)];
  const b = document.createElement('br');
  const s = document.createElement('span');
  s.className = 'out';
  s.innerHTML = `> Received score engine report: ${rLog}`;
  $('#term').appendChild(b);
  $('#term').appendChild(s);
  $('#term').scrollTop = $('#term').scrollHeight;
  sndBeep();
}

function resetScore(){
  $('#term').innerHTML = '<span class="cmd">$ sudo ./score.sh</span><br><span class="out">Scoring array reset. Ready for deployment.</span>';
  currentXp = 0;
  $('#hudScore').textContent = '000';
  for(let i=1; i<=4; i++) {
    $(`#r${i}`).style.setProperty('--pct', '0');
    $(`#r${i}`).querySelector('span').innerHTML = `0%<small>OP-0${i}</small>`;
    $(`#r${i}`).style.background = 'none';
  }
}

function toast(msg){
  const t=$('#toast');t.textContent=msg;t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),4000);
}

function unlockAchievement(title,text){
  const a=$('#achievement');$('#achTitle').textContent=title;$('#achText').textContent=text;
  a.classList.add('show');setTimeout(()=>a.classList.remove('show'),5000);
}
</script>
