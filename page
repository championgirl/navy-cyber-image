/* Critical extreme motion updates */
@keyframes glitchText {
  0%, 100% { text-shadow: 0 0 20px rgba(0,255,224,.6); }
  50% { text-shadow: -3px -2px 0 var(--red), 3px 2px 0 var(--blue); }
}
@keyframes screenShake {
  0% { transform: translate(0, 0) rotate(0deg); }
  100% { transform: translate(1px, 1px) rotate(0.2deg); }
}

.glitch{position:relative}
.glitch:before,.glitch:after{content:attr(data-text);position:absolute;inset:0}
.glitch:before{color:var(--cyan2);clip-path:polygon(0 0,100% 0,100% 45%,0 45%);animation:gl1 var(--glitch-speed) infinite linear alternate-reverse}
.glitch:after{color:var(--red);clip-path:polygon(0 55%,100% 55%,100% 100%,0 100%);animation:gl2 var(--glitch-speed) infinite linear alternate-reverse}
@keyframes gl1{0%,100%{transform:none}92%{transform:skew(-5deg) translate(-5px)}94%{transform:none}96%{transform:translate(4px, -2px)}98%{transform:none}}
@keyframes gl2{0%,100%{transform:none}91%{transform:none}93%{transform:skew(5deg) translate(5px)}95%{transform:none}97%{transform:translate(-4px, 2px)}99%{transform:none}}

@media (prefers-reduced-motion: reduce){*,*:before,*:after{animation:none!important;transition:none!important}body{cursor:auto}#cursor,#cursor-dot{display:none}}
</style>
