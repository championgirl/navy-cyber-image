.achievement.show{transform:none}.badge{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--amber),#ff7b00);display:grid;place-items:center;color:#1d1100;font-weight:900;box-shadow:0 0 15px rgba(255,123,0,0.4)}
